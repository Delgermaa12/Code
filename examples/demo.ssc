print("===== SALARY CALCULATION SYSTEM =====");

input(employee_name);
input(worked_hours);
input(hourly_rate);
input(penalty);

let gross_salary = worked_hours * hourly_rate;
let social_insurance = gross_salary * 0.115;
let salary_after_social = gross_salary - social_insurance;
let income_tax = salary_after_social * 0.10;
let net_salary = salary_after_social - income_tax - penalty;

print("===== RESULT =====");
print(employee_name);
print(gross_salary);
print(social_insurance);
print(income_tax);
print(penalty);
print(net_salary);