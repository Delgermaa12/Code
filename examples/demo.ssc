print("===== SALARY SYSTEM =====");

input(worked_hours);
input(hourly_rate);
input(penalty);

let gross_salary = worked_hours * hourly_rate;
let social_insurance = gross_salary * 0.115;
let salary_after_social = gross_salary - social_insurance;
let income_tax = salary_after_social * 0.10;
let net_salary = salary_after_social - income_tax - penalty;

print("Gross salary:");
print(gross_salary);

print("Social insurance:");
print(social_insurance);

print("Income tax:");
print(income_tax);

print("Penalty:");
print(penalty);

print("Net salary:");
print(net_salary);

if (penalty > 0) {
    print("Penalty applied");
} else {
    print("No penalty");
}

print("===== END =====");